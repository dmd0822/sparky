# Sparky Azure config template (keyless / Entra ID)
# Copy to .env and fill in the values for your environment.
# Keep secrets out of source control; do not commit a real .env file.

# Azure identity / tenant
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_RESOURCE_GROUP=sparky-rg
AZURE_LOCATION=eastus

# Azure identity mode: use managed identity / Azure AD auth instead of keys.
USE_MANAGED_IDENTITY=true
USE_DEFAULT_AZURE_CREDENTIAL=true

# Azure OpenAI (no API key)
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=sparky-gpt-4o-mini
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure Speech (no API key)
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US
AZURE_SPEECH_VOICE_NAME=en-US-JennyNeural

# Azure AI Content Safety (no API key)
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_API_VERSION=2024-09-01

# Broker / device boundary (device should not carry long-lived cloud secrets)
SPARKY_BROKER_BASE_URL=https://sparky-broker.<region>.azurewebsites.net
SPARKY_DEVICE_CLIENT_CERT_PATH=
SPARKY_DEVICE_CLIENT_CERT_PASSWORD=
SPARKY_DEVICE_CERT_THUMBPRINT=

# Optional local overrides
SPARKY_LOG_LEVEL=INFO
SPARKY_ENV=development
